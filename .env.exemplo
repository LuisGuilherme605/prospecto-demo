# Copie para .env e preencha. O arquivo .env nao deve ir para o Git.

# Dominio apontado para o IP do servidor (registro A no DNS).
DOMINIO=prospecto.seudominio.com.br

# E-mail para os avisos do Let's Encrypt sobre o certificado.
EMAIL=voce@seudominio.com.br

# Senha de acesso ao painel. Use uma senha longa e exclusiva.
PROSPECTO_SENHA=troque-esta-senha

# Chave de assinatura das sessoes. Gere com:
#   openssl rand -hex 32
# Sem ela, todo mundo e deslogado a cada reinicio do container.
PROSPECTO_SEGREDO=troque-por-uma-chave-aleatoria-de-64-caracteres

# Validade da sessao, em horas.
PROSPECTO_SESSAO_HORAS=12
